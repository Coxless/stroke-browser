# Windows 用の開発環境（WSL container）。手順は docs/dev-environment.md
# .workshop/ の Ubuntu 環境と、入るものを揃えている。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      build-essential \
      pkg-config \
      python3 \
      python3-tk \
      fontconfig \
      fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/*

# Phase 1（Servo）。.workshop/stroke-dev/hooks/setup-base と同じ一覧
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      clang \
      cmake \
      g++ \
      gperf \
      libdbus-1-dev \
      libegl1-mesa-dev \
      libfreetype6-dev \
      libgl1-mesa-dri \
      libgles2-mesa-dev \
      libglib2.0-dev \
      libharfbuzz-dev \
      liblzma-dev \
      libudev-dev \
      libunwind-dev \
      libvulkan1 \
      libx11-dev \
      libxcb-render0-dev \
      libxcb-shape0-dev \
      libxcb-xfixes0-dev \
      libxkbcommon0 \
      libxkbcommon-x11-0 \
      libxmu-dev \
      libxmu6 \
      llvm-dev \
      m4 \
      xorg-dev \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash dev
USER dev
ENV PATH=/home/dev/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# ソースは Windows 側から /project に渡す。ビルドの成果物はコンテナの中に置く
ENV CARGO_TARGET_DIR=/home/dev/target
WORKDIR /project
CMD ["bash"]
