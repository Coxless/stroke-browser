#!/bin/bash
# root で実行される。apt でパッケージを入れる。container/Containerfile と揃えること。
export DEBIAN_FRONTEND=noninteractive
apt-get update
# Phase 0（Python のトイブラウザ）
apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  build-essential \
  pkg-config \
  python3 \
  python3-tk \
  fontconfig \
  fonts-noto-cjk
# Phase 1（Servo）。Servo の apt_common.txt（v0.1.3）から、使わない GStreamer の分を除いたもの。
# 理由と元の一覧は docs/dev-environment.md の「Servo のビルドに要るもの」
apt-get install -y --no-install-recommends \
  clang \
  cmake \
  g++ \
  gperf \
  libdbus-1-dev \
  libegl1-mesa-dev \
  libfreetype6-dev \
  libgl1-mesa-dri \
  libgles2-mesa-dev \
  libglib2.0-dev \
  libharfbuzz-dev \
  liblzma-dev \
  libudev-dev \
  libunwind-dev \
  libvulkan1 \
  libwayland-egl1 \
  libx11-dev \
  libxcb-render0-dev \
  libxcb-shape0-dev \
  libxcb-xfixes0-dev \
  libxkbcommon0 \
  libxkbcommon-x11-0 \
  libxmu-dev \
  libxmu6 \
  llvm-dev \
  m4 \
  xorg-dev
